<!-- only if the guest can't fit the 64 GB BAR. merge in with: virsh edit rocm-guest -->

<!-- bigger 64-bit PCI window, goes on the existing pcie-root controller -->
<controller type='pci' index='0' model='pcie-root'>
  <pcihole64 unit='GiB'>128</pcihole64>
</controller>

<!-- managed='yes': libvirt swaps amdgpu for vfio-pci on start and back on stop -->
<hostdev mode='subsystem' type='pci' managed='yes'>
  <source>
    <address domain='0x0000' bus='0x0c' slot='0x00' function='0x0'/>
  </source>
  <rom bar='off'/>
</hostdev>
