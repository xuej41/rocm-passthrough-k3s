{
  "uid": "mi210-gpu",
  "title": "MI210 GPU",
  "description": "AMD Instinct MI210 metrics from AMD's Device Metrics Exporter.",
  "tags": [
    "amd",
    "gpu",
    "rocm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "hostname",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(gpu_gfx_activity, hostname)",
        "query": {
          "qryType": 1,
          "query": "label_values(gpu_gfx_activity, hostname)",
          "refId": "hostname-q"
        },
        "refresh": 2,
        "sort": 3,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      },
      {
        "name": "gpu_id",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(gpu_gfx_activity{hostname=\"$hostname\"}, gpu_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(gpu_gfx_activity{hostname=\"$hostname\"}, gpu_id)",
          "refId": "gpu_id-q"
        },
        "refresh": 2,
        "sort": 3,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Compute activity",
      "description": "GFX engine busy %, gpu_gfx_activity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpu_gfx_activity{hostname=\"$hostname\", gpu_id=\"$gpu_id\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Power",
      "description": "Board power in watts, gpu_power_usage (falls back to gpu_average_package_power).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpu_power_usage{hostname=\"$hostname\", gpu_id=\"$gpu_id\"} or gpu_average_package_power{hostname=\"$hostname\", gpu_id=\"$gpu_id\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Edge temperature",
      "description": "gpu_edge_temperature (MI2xx). Amber from 85 °C, red from 95 °C.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpu_edge_temperature{hostname=\"$hostname\", gpu_id=\"$gpu_id\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 85
              },
              {
                "color": "#d03b3b",
                "value": 95
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "VRAM used",
      "description": "gpu_used_vram / gpu_total_vram.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(gpu_used_vram{hostname=\"$hostname\", gpu_id=\"$gpu_id\"}) / sum(gpu_total_vram{hostname=\"$hostname\", gpu_id=\"$gpu_id\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "PCIe speed",
      "description": "Current vs maximum link speed in GT/s (pcie_speed, pcie_max_speed). Idle GPUs drop to a lower speed; check under load.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(pcie_speed{hostname=\"$hostname\", gpu_id=\"$gpu_id\"})",
          "legendFormat": "now",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(pcie_max_speed{hostname=\"$hostname\", gpu_id=\"$gpu_id\"})",
          "legendFormat": "max",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: GT/s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Health",
      "description": "gpu_health computed by the exporter: 1 = healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpu_health{hostname=\"$hostname\", gpu_id=\"$gpu_id\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✓ Healthy",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "✕ Unhealthy",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Activity",
      "description": "How busy the compute engine (GFX) and memory controller (UMC) are.",
      "datasource": {
        "type": "prometheus",
